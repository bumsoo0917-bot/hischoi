# Firebase Web SDK (브라우저에 공개되어도 되는 Firebase 앱 식별 설정)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (Vercel 서버 전용, NEXT_PUBLIC_ 접두사를 사용하지 않음)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM 줄바꿈을 \\n으로 치환한 값. 실제 키는 절대 저장소에 커밋하지 마세요.
FIREBASE_PRIVATE_KEY=
